/* Shared 720 × 405 certificate composition. No external font or image requests. */
const UC_CERTIFICATE={
 layout(c){
  const fit=(value,max,width,lines=1,height=999)=>{const text=String(value||'');let size=max;while(size>7){const capacity=width/(size*.57);let count=1,used=0;for(const word of text.split(/\s+/)){if(word.length>capacity){count+=Math.ceil(word.length/capacity)-1;used=word.length%capacity;}else if(used+word.length+1>capacity){count++;used=word.length;}else used+=word.length+1;}if(count<=lines&&count*size*1.18<=height-6)break;size-=.5;}return size;};
  const box=(id,text,x,y,w,h,size,font='Arial',color='#1c2a40',bold=false)=>({id,text:String(text||''),x,y,w,h,size,font,color,bold});
  const issuer=c.company||'Xpanzia Group',name=c.name||'Nombre del participante',title=c.title||'Nombre del curso';
  return [
   box('brand','UNIVERSIDAD CORPORATIVA',240,35,365,18,11,'Arial','#383838',true),
   box('company',issuer,240,54,365,18,fit(issuer,10,350,1,18),'Arial','#666666'),
   box('eyebrow','CERTIFICADO DE',130,97,460,19,12,'Arial','#a81724',true),
   box('heading','APROBACIÓN',100,118,520,42,34,'Georgia','#991322',true),
   box('intro','Otorgado a',170,165,380,17,9.5,'Arial','#666666'),
   box('name',name,100,185,520,47,fit(name,29,490,2,47),'Georgia','#303030'),
   box('body','Por completar y aprobar satisfactoriamente '+(c.routeId?'la ruta de aprendizaje':'el curso'),100,238,520,18,9.5,'Arial','#5c5c5c'),
   box('title',title,110,259,500,34,fit(title,18,470,2,34),'Georgia','#343434',true),
   box('details',String(c.hours)+' horas  ·  Fecha de aprobación: '+String(c.date||'').slice(0,10),150,299,420,18,8.5,'Arial','#666666'),
   box('signer',c.signer||'Xpanzia Group',125,351,200,25,fit(c.signer||'Xpanzia Group',8,185,2,25),'Arial','#3c3c3c',true),
   box('signer-role','Firma institucional',125,375,200,11,7,'Arial','#666666'),
   box('verification','VERIFICACIÓN DIGITAL',382,332,176,15,8,'Arial','#9a772c',true),
   box('code',c.code||'VISTA PREVIA',372,349,196,13,7,'Arial','#444444'),
   {...box('link','Verificar autenticidad',389,366,162,13,7.5,'Arial','#666666'),link:/^https:\/\//.test(c.portalUrl||'')?c.portalUrl.replace(/#.*$/,'')+'#verificar/'+encodeURIComponent(c.code||''):''}
  ];
 }
};

function certificateBackground_(){return Utilities.newBlob(Utilities.base64Decode(""),"image/jpeg","certificate-background.jpg");}

function xpanziaLogo_(){return Utilities.newBlob(Utilities.base64Decode(""),"image/jpeg","xpanzia-logo.jpg");}

function certificateText_(shape,b){
 const text=shape.getText();text.setText(b.text);
 text.getTextStyle().setFontFamily(b.font).setFontSize(b.size).setForegroundColor(b.color).setBold(b.bold);
 text.getParagraphStyle().setParagraphAlignment(SlidesApp.ParagraphAlignment.CENTER).setSpaceAbove(0).setSpaceBelow(0);
 shape.setContentAlignment(SlidesApp.ContentAlignment.MIDDLE);
 if(b.link)text.getTextStyle().setLinkUrl(b.link);
}
// Run once from the editor to authorize Slides and prepare the reusable private template.
function prepararCertificadoPremium(){
 resetRequest_();const folderId=prop_('CERTIFICATE_FOLDER_ID');need_(folderId,'Primero debe existir la carpeta de certificados de tu instalación actual.');
 const deck=SlidesApp.create('Xpanzia Group — Diploma institucional');const file=DriveApp.getFileById(deck.getId());
 try{
  file.moveTo(DriveApp.getFolderById(folderId));const slide=deck.getSlides()[0];slide.getPageElements().forEach(e=>e.remove());
  need_(Math.abs(deck.getPageWidth()/deck.getPageHeight()-720/405)<0.01,'La plantilla requiere formato panorámico 16:9.');
  slide.insertImage(certificateBackground_(),0,0,720,405);
  const sample={...settings_(),name:'Nombre del participante',title:'Nombre del curso',hours:2,date:now_(),code:'VISTA PREVIA'};
  UC_CERTIFICATE.layout(sample).forEach(b=>{const shape=slide.insertTextBox(b.text,b.x,b.y,b.w,b.h);shape.setTitle('uc_'+b.id);certificateText_(shape,b);});
  slide.insertImage(xpanziaLogo_(),105,35,115,115*138/512);
  slide.insertImage(xpanziaLogo_(),170,322,110,110*138/512);
  [[158,233,403]].forEach(v=>{const line=slide.insertLine(SlidesApp.LineCategory.STRAIGHT,v[0],v[1],v[0]+v[2],v[1]);line.getLineFill().setSolidFill('#c7ac67');line.setWeight(.6);});
  deck.saveAndClose();PropertiesService.getScriptProperties().setProperty('CERTIFICATE_PREMIUM_TEMPLATE_ID',file.getId());
  console.log('Plantilla premium lista: '+file.getUrl());return file.getId();
 }catch(error){file.setTrashed(true);throw error;}
}
function generatePremiumPdf_(c){
 const templateId=prop_('CERTIFICATE_PREMIUM_TEMPLATE_ID');need_(templateId,'Ejecuta prepararCertificadoPremium() una vez en Apps Script antes de emitir el nuevo PDF.');
 const folder=DriveApp.getFolderById(prop_('CERTIFICATE_FOLDER_ID'));
 const copy=DriveApp.getFileById(templateId).makeCopy('Temporal '+c.code,folder);
 try{
  const deck=SlidesApp.openById(copy.getId()),shapes=deck.getSlides()[0].getShapes();
  UC_CERTIFICATE.layout(c).forEach(b=>{const shape=shapes.find(s=>s.getTitle()==='uc_'+b.id);need_(shape,'Falta el campo '+b.id+' en la plantilla. Vuelve a prepararla.');certificateText_(shape,b);});
  deck.saveAndClose();const pdf=copy.getAs(MimeType.PDF).setName(c.code+'.pdf');const file=folder.createFile(pdf);
  const updated={...c,fileId:file.getId(),designVersion:'xpanzia-1'};
  try{put_('Certificates',updated);}catch(error){file.setTrashed(true);throw error;}
  Object.assign(c,updated);
 }finally{copy.setTrashed(true);}
}
